{
  "rules": {
    "lobby": {
      ".read": true,
      ".write": "auth != null",
      "$mode": {
        "table_$tableNum": {
          ".read": true,
          ".write": "auth != null"
        }
      }
    },
    "game_states": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$gameId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "players": {
          "$uid": {
            ".read": "auth != null",
            ".write": "auth != null"
          }
        }
      }
    }
  }
}
